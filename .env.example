# Connection string PostgreSQL (Neon / Supabase / Railway, dll)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# WAJIB: string acak panjang (min. 16 karakter). Contoh membuat:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRES_MINUTES=1440

# Opsional: password akun admin saat seed (default: admin123)
ADMIN_PASSWORD=
